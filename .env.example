# Copy to .env and fill in the credentials of your approved apps.
# Each platform's redirect URI must be registered exactly as:  {BASE_URL}/callback/{platform}
# e.g. http://localhost:4400/callback/youtube
# Meta and TikTok only accept https redirect URIs for non-localhost hosts; if a console rejects
# localhost, run a tunnel (cloudflared / ngrok) and set BASE_URL to the https tunnel address.

PORT=4400
BASE_URL=http://localhost:4400

# Google Cloud console -> OAuth client (Web application). Enable "YouTube Data API v3".
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok for Developers -> app with Login Kit + Content Posting API (Direct Post).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta app (type Business) with "Facebook Login for Business" + "Instagram API with Facebook Login".
# One app serves both platforms. Instagram must be a Business/Creator account linked to a Facebook Page.
# Register both {BASE_URL}/callback/facebook and {BASE_URL}/callback/instagram as redirect URIs.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# X developer portal -> app with OAuth 2.0 enabled, type "Web App" (confidential client).
X_CLIENT_ID=
X_CLIENT_SECRET=

# Graph API version used for Instagram and Facebook calls.
META_GRAPH_VERSION=v24.0

# Max successful posts per account per rolling 24h. Jobs over the cap wait instead of failing.
DAILY_CAP_YOUTUBE=6
DAILY_CAP_TIKTOK=15
DAILY_CAP_INSTAGRAM=50
DAILY_CAP_FACEBOOK=30
DAILY_CAP_X=50

# X limits for standard accounts; raise for Premium accounts.
X_MAX_CHARS=280
X_MAX_VIDEO_SECONDS=140

# Required whenever BASE_URL is not localhost (e.g. behind a tunnel): HTTP Basic password for the UI.
APP_PASSWORD=
