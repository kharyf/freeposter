{
  "tool": "remotion",
  "description": "Two columns split by a gold rule: before and after, or A versus B, each with a small title and a big value.",
  "minSec": 3,
  "maxSec": 6,
  "params": {
    "left_title": { "type": "string", "required": true, "maxLength": 40 },
    "left": { "type": "string", "required": true, "maxLength": 40 },
    "right_title": { "type": "string", "required": true, "maxLength": 40 },
    "right": { "type": "string", "required": true, "maxLength": 40 }
  },
  "fallback": "keyword-card",
  "fallbackParams": { "phrase": "$main" },
  "example": { "left_title": "Before", "left": "4 hours", "right_title": "After", "right": "10 minutes" }
}
